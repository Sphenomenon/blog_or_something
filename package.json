{
  "name": "nocturne-archive-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:article-media": "npm run generate:article-media-assets && npm run validate:article-media-content",
    "predev": "npm run prepare:article-media && npm run generate:decorative-accents && node scripts/note-article-media-dev-restart.mjs",
    "dev": "vite",
    "dev:verification": "npm run prepare:article-media-verification && vite --mode verification",
    "optimize-images": "node scripts/optimize-images.mjs",
    "generate:article-media-assets": "node scripts/generate-article-media-assets.mjs",
    "generate:decorative-accents": "node scripts/generate-decorative-accents.mjs",
    "validate:article-media-content": "node scripts/validate-article-media-content.mjs",
    "prepare:article-media-verification": "node scripts/prepare-article-media-verification.mjs",
    "generate:food-map-json": "node scripts/generate-food-map-json.mjs",
    "prebuild": "npm run prepare:article-media && npm run generate:decorative-accents",
    "build": "npm run optimize-images && npm run generate:food-map-json && vite build",
    "preview": "vite preview",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:article-media-parser": "node scripts/verify-article-media-parser.mjs",
    "verify:article-media-assets": "node scripts/verify-article-media-assets.mjs",
    "verify:article-media-render": "node scripts/verify-article-media-render.mjs",
    "verify:article-media-sources": "node scripts/verify-article-media-sources.mjs",
    "verify:article-media-layout": "node scripts/verify-article-media-layout.mjs",
    "verify:article-media-lightbox": "node scripts/verify-article-media-lightbox.mjs",
    "verify:article-media-browser": "node scripts/verify-article-media-browser.mjs",
    "verify:article-media-fixtures": "node scripts/verify-article-image-fixtures.mjs",
    "verify:article-media-isolation": "node scripts/verify-article-media-production-isolation.mjs",
    "verify:article-media": "node scripts/verify-article-media.mjs",
    "verify:food-map-schema": "node scripts/verify-food-map-schema.mjs",
    "verify:food-map-content": "node scripts/verify-food-map-content.mjs",
    "verify:food-map-amap": "node scripts/verify-food-map-amap.mjs",
    "verify:food-map-external": "node scripts/verify-food-map-external.mjs",
    "verify:food-map-browser": "node scripts/verify-food-map-browser.mjs",
    "verify:food-map": "node scripts/verify-food-map.mjs"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^4.1.2",
    "js-yaml": "^4.1.1",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.14"
  }
}
